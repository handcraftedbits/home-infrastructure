{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:latest"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "prompts": {
        "github-AssignCodingAgent": {
          "enabled": false
        },
        "github-issue_to_fix_workflow": {
          "enabled": false
        }
      },
      "resources": {
        "ui://github-mcp-server/get-me": {
          "enabled": false
        },
        "ui://github-mcp-server/issue-write": {
          "enabled": false
        },
        "ui://github-mcp-server/pr-edit": {
          "enabled": false
        },
        "ui://github-mcp-server/pr-write": {
          "enabled": false
        }
      }
    },

    "jina": {
      "type": "streamable-http",
      "url": "http://mcp-jina:8000",
      "owner": "admin"
    }
    ,
    "searxng": {
      "type": "streamable-http",
      "url": "http://mcp-searxng:3000/mcp",
      "owner": "admin",
      "resources": {
        "config://server-config": {
          "enabled": false
        },
        "help://usage-guide": {
          "enabled": false
        }
      }
    }
  },

  "systemConfig": {
    "routing": {
      "enableBearerAuth": false
    }
  }
}
