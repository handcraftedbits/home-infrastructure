{
  "agent": {
    "code-explorer": {
      "permission": {
        "bash": {
          "*": "deny",
          "git *": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow"
      }
    },
    "database-explorer": {
      "disable": true
    },
    "documenter": {
      "permission": {
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "read": "allow"
      }
    }
  }
}
