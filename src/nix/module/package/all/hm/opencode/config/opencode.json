{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "compaction": {
      "model": "llm/task"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "summary": {
      "model": "llm/task"
    },
    "title": {
      "model": "llm/task"
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "tools": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.howard.estate/mcp"
    }
  },
  "model": "llm/main",
  "plugin": [
    "opencode-pty"
  ],
  "provider": {
    "llm": {
      "models": {
        "main": {
          "limit": {
            "context": 262144,
            "output": 81920
          },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "main",
          "reasoning": true,
          "temperature": true
        },
        "task": {
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "task",
          "reasoning": true,
          "temperature": true
        }
      },
      "name": "llm",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llm.howard.estate/v1"
      }
    }
  },
  "subagent_depth": 8
}

