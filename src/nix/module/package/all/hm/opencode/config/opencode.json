{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "main": {
      "mode": "primary",
      "permission": {
        "searxng_*": "deny",
        "searxng_searxng_web_search": "allow",
        "webfetch": "deny"
      },
      "presence_penalty": 0.0,
      "repetition_penalty": 1.0,
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "plan": {
      "disable": true
    },
    "title": {
      "disable": true
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "jina": {
      "enabled": true,
      "type": "remote",
      "url": "https://jina.mcp.howard.estate"
    },
    "searxng": {
      "enabled": true,
      "type": "remote",
      "url": "https://searxng.mcp.howard.estate/mcp"
    }
  },
  "model": "coding/gemma4-31b",
  "provider": {
    "coding": {
      "models": {
        "gemma4-31b": {
          "name": "Gemma4 31B",
          "temperature": true,
          "reasoning": true,
          "options": {
            "contextLength": 262144,
            "maxTokens": 81920
          }
        }
      },
      "name": "coding",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://coding.llm.howard.estate/v1"
      }
    }
  }
}
