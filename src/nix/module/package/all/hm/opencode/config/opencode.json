{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "code-explorer": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "documenter": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "skill": {
          "*": "deny",
          "write-*": "allow"
        }
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "main": {
      "mode": "primary",
      "permission": {
        "*": "deny",
        "question": "allow",
        "task": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "plan": {
      "disable": true
    },
    "researcher": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "jina_*": "allow",
        "searxng_searxng_web_search": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "summary": {
      "disable": true
    },
    "title": {
      "disable": true
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "jina": {
      "enabled": true,
      "type": "remote",
      "url": "https://jina.mcp.howard.estate"
    },
    "searxng": {
      "enabled": true,
      "type": "remote",
      "url": "https://searxng.mcp.howard.estate/mcp"
    }
  },
  "model": "coding/gemma4-31b",
  "provider": {
    "coding": {
      "models": {
        "gemma4-31b": {
          "name": "Gemma4 31B",
          "temperature": true,
          "reasoning": true,
          "options": {
            "contextLength": 262144,
            "maxTokens": 81920
          }
        }
      },
      "name": "coding",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://coding.llm.howard.estate/v1"
      }
    }
  }
}

