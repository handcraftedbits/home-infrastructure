{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "code-explorer": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "tools_github-get_commit": "allow",
        "tools_github-get_file_contents": "allow",
        "tools_github-get_label": "allow",
        "tools_github-get_latest_release": "allow",
        "tools_github-get_me": "allow",
        "tools_github-get_release_by_tag": "allow",
        "tools_github-get_tag": "allow",
        "tools_github-get_teams": "allow",
        "tools_github-issue_read": "allow",
        "tools_github-list_branches": "allow",
        "tools_github-list_commits": "allow",
        "tools_github-list_issue_fields": "allow",
        "tools_github-list_issue_types": "allow",
        "tools_github-list_issues": "allow",
        "tools_github-list_pull_requests": "allow",
        "tools_github-list_pull_releases": "allow",
        "tools_github-list_pull_repository_collaborators": "allow",
        "tools_github-list_tags": "allow",
        "tools_github-pull_request_read": "allow",
        "tools_github-search_code": "allow",
        "tools_github-search_commits": "allow",
        "tools_github-search_issues": "allow",
        "tools_github-search_pull_requests": "allow",
        "tools_github-search_repositories": "allow",
        "tools_github-search_users": "allow",
        "question": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "database-explorer": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "question": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "documenter": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "question": "allow",
        "skill": {
          "*": "deny",
          "write-*": "allow"
        }
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "main": {
      "mode": "primary",
      "permission": {
        "*": "deny",
        "question": "allow",
        "task": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "plan": {
      "disable": true
    },
    "researcher": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "tools_jina-*": "allow",
        "tools_searxng-searxng_web_search": "allow"
      },
      "temperature": 1.0,
      "top_k": 64,
      "top_p": 0.95
    },
    "summary": {
      "disable": true
    },
    "title": {
      "disable": true
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "tools": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.howard.estate/mcp"
    }
  },
  "model": "coding/gemma4-31b",
  "provider": {
    "coding": {
      "models": {
        "gemma4-31b": {
          "name": "Gemma4 31B",
          "temperature": true,
          "reasoning": true,
          "options": {
            "contextLength": 262144,
            "maxTokens": 81920
          }
        }
      },
      "name": "coding",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://coding.llm.howard.estate/v1"
      }
    }
  }
}

